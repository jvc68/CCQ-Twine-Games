:: StoryInit {"position": "100,100", "size": "100,100"}
<<set $zombieDistance = 10000>>
<<set $currentFidget = "bubbleWrap">>



:: Home
<div class="phone">Time Spent: TODO
Bubble Wrap
<div class="fidgetInterface" id="container"></div>
  <<done>><<run setup.populateFidget("bubbleWrap")>><</done>>
</div>

:: UserScript [script]
  setup.populateFidget = function populateFidget(name) {
    let container = document.getElementById("container");
    switch (name) {
      case "bubbleWrap":
        /*Do math here based on size of screen to know how many bubbles to make */
        for (let i = 0; i < (13*12); i++) {
          let newButton = document.createElement('button');
          newButton.classList.add("bubble");
          container.appendChild(newButton);
        }
        break;
      default:
        console.log("Something went wrong when populating fidget")
    }
  }


:: UserStylesheet [stylesheet]
/* ============================================================
   Daily archer — visual stylesheet
   Arial font, click handler on cells (no passage refresh on
   click), compact phone height.

   CardioCareQuest viridis palette (canonical across all games):
     #440154  deep purple   — phone gradient stop 1
     #3b528b  blue          — phone gradient stop 2
     #21918c  teal          — phone gradient stop 3 / marked cell
     #5ec962  green          — win banner / success
     #fde725  yellow         — title / FREE / primary CTA
     #f4f1d8  cream          — page background
   2026-05-10: phone gradient + dark-text accent (#1a1a1a) replaced
   to align with viridis anchor stops.
   ============================================================ */

* { box-sizing: border-box; }

body {
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
  background-color: #d1e8e8;
  margin: 0;
  padding: 1.5em 0;
}

/*#ui-bar { display: none; }*/

#story {
  margin: 0 auto;
  max-width: 380px;
  padding: 0;
}

/* Phone frame — compact, soft dark viridis teal */
.phone {
  background: linear-gradient(to top, #00f187, #0004fd);
  border-radius: 32px;
  padding: 25px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  color: white;
  position: relative;
  min-height: 660px;
  max-height: 100px;
  width: 100%;
  max-width: 100%;
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
}

.fidgetInterface {
  background: lightgrey;
  border-radius: 12px;
  border: 1px solid black;
  padding: 8px;
  padding-left: 13px;
}

.bubble {
  border-radius: 32px;
  min-width: 25px;
  min-height: 25px
}
