:: Start
<div class="phone start-screen">\
    <h1>Food Truck</h1>\
    <p>Serve customers, prepare delicious meals, and grow your food truck.</p>\
    <div class="action-button start-actions">\
        <<button "Start Day" "TakeOrderScreen">><<run FoodTruck.endTutorial()>><<run FoodTruck.startDay()>><</button>>\
        <<button "Play Tutorial" "TakeOrderScreen">><<run FoodTruck.startTutorial()>><</button>>\
        <<button "Toggle Debug Mode" "Start">><<run FoodTruck.toggleDebugMode()>><</button>>\
    </div>\
</div>\

:: TakeOrderScreen
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <section class="customer-panel">\
        <div class="customer-window">\
            <div class="customer-face" role="img" aria-label="Placeholder customer face">🙂</div>\
        </div>\
        <div class="customer-details">\
            <<if $activeOrder>>\
                <h3>$activeOrder.custName</h3>\
                <p>"I'd like a $activeOrder.dishName, please!"</p>\
            <<else>>\
                <<if $numOrders > 0>>\
                    <p>A customer is waiting. Take their order to get started.</p>\
                <<else>>\
                    <p>All orders have been served for today.</p>\
                <</if>>\
            <</if>>\
        </div>\
    </section>\
    <div class="action-button order-actions">\
        <<if !$activeOrder && $numOrders > 0>>\
            <<button "Take Order" "TakeOrderScreen">><<run FoodTruck.takeOrder()>><</button>>\
        <<elseif $activeOrder>>\
            <p class="order-status">Order received. Head to the assembly station.</p>\
        <</if>>\
        <<if FoodTruck.canFulfillOrder()>>\
            <<button "Fulfill Order">><<run FoodTruck.fulfillOrder()>><</button>>\
        <<elseif $activeOrder>>\
            <span class="fulfill-hint">Complete Order to Fulfill.</span>\
        <</if>>\
    </div>\
    <div class="prep-area">\
        <h4>Prep Tray</h4>\
        <div id="tray">\
            <<if $prepTray.length === 0>>\
                <em>No ingredients added yet.</em>\
            <<else>>\
                <<print $prepTray.join(" + ")>>\
            <</if>>\
        </div>\
    </div>\
    <div class="passage-nav">\
        <<button "Exit to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.startTutorialIngredients()>><</button>>\
    </div>\
</div>

:: DayTally
<div class="phone day-tally-screen">\
    <section class="day-tally-box">\
        <h2>Customer Satisfaction</h2>\
        <p class="tally-stars" aria-label="Customer satisfaction: $satisfactionScore out of 5 stars"><<print FoodTruck.starRating($satisfactionScore)>></p>\
        <h2>Healthiness</h2>\
        <p class="tally-stars" aria-label="Healthiness: $healthinessScore out of 5 stars"><<print FoodTruck.starRating($healthinessScore)>></p>\
        <p class="tally-tip"><<print FoodTruck.dayTips()>></p>\
        <div class="action-button">\
            <<if $tutorialMode>>\
                <<button "Return to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
            <<else>>\
                <<button "Start Next Day" "TakeOrderScreen">><<run FoodTruck.startNextDay()>><</button>>\
            <</if>>\
        </div>\
    </section>\
</div>

:: AssemblyStation
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<if $activeOrder>>\
    <div class="ticket-box">\
        <div class="ticket-header">\
            <h3>Active Ticket</h3>\
            <div class="timer-display">\
                <span class="timer-label">Time Left:</span>\
                <span id="order-timer" class="timer-value"><<print FoodTruck.orderTimerDisplay()>></span>\
            </div>\
        </div>\
        <h3>Customer: $activeOrder.custName</h3>\
        <p>Order: $activeOrder.dishName</p>\
        <p>Needs: <<print $activeOrder.requiredIngredients.join(", ")>></p>\
    </div>\
    <<else>>\
    <div class="ticket-box">\
        <p>No active order. Return to the Order Window to take a customer's order.</p>\
    </div>\
    <</if>>\
    <div class="prep-area">\
        <h4>Prep Tray</h4>\
        <div id="tray">\
            <<if $prepTray.length === 0>>\
                <em>Tap ingredients to add them to the tray.</em>\
            <<else>>\
                <<print $prepTray.join(", ")>>\
            <</if>>\
        </div>\
        <div class="tray-controls">\
            <<button "Clear Tray">><<run FoodTruck.clearTray()>><</button>>\
        </div>\
    </div>\
    <<if $activeOrder>>\
    <div class="ingredient-shelf">\
        <h4>Ingredient Bins</h4>\
        <div class="ingredient-grid">\
            <<for _i = 0; _i < $menuIngredients.length; _i++>>\
                <<capture _i>>\
                <button type="button" class="ingredient-button">\
                    <span class="ingredient-icon"><<print $menuIngredients[_i].img>></span>\
                    <span class="ingredient-name"><<print $menuIngredients[_i].name>></span>\
                </button>\
                <</capture>>\
            <</for>>\
        </div>\
    </div>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Exit to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
        <<button "Order Window" "TakeOrderScreen">><<run FoodTruck.finishTutorialPrep()>><</button>>\
    </div>\
</div>

:: PrepareIngredient
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<if $pendingIngredient>>\
        <div class="ticket-box">\
            <h3>Prepare $pendingIngredient.name</h3>\
            <p>Choose a preparation method:</p>\
        </div>\
        <div class="method-options">\
            <<button `FoodTruck.methodLabel("healthy")` "CookingMinigame">><<run FoodTruck.chooseMethod("healthy")>><</button>>\
            <<button `FoodTruck.methodLabel("unhealthy")` "CookingMinigame">><<run FoodTruck.chooseMethod("unhealthy")>><</button>>\
        </div>\
    <<else>>\
        <p>Select an ingredient from the assembly station to prepare it.</p>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><</button>>\
    </div>\
</div>

:: CookingMinigame
<<run FoodTruck.updateCookingMarkerSpeed()>>
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<if $pendingIngredient && $pendingMethod>>\
        <div class="ticket-box">\
            <h3>Cooking $pendingIngredient.name</h3>\
            <p>Method: $pendingMethod.label</p>\
        </div>\
        <<if $cookingResult>>\
            <p>The ingredient has already been prepared.</p>\
            <<button "View Cooking Result" "CookingResult">><</button>>\
        <<else>>\
            <p class="skill-instructions">Stop the marker in the green section for a perfect cook.</p>\
            <div class="skill-track" role="img" aria-label="Cooking skill check: blue is raw, green is perfect, and red is overcooked">\
                <div class="skill-zone skill-zone-raw"></div>\
                <div class="skill-zone skill-zone-perfect"></div>\
                <div class="skill-zone skill-zone-overcooked"></div>\
                <div id="skill-marker" class="skill-marker"></div>\
            </div>\
            <div class="skill-legend">\
                <span>Raw</span>\
                <span>Perfect</span>\
                <span>Overcooked</span>\
            </div>\
            <div class="action-button">\
                <<button "Stop Cooking" "CookingResult">><<run FoodTruck.stopCooking()>><</button>>\
            </div>\
        <</if>>\
    <<else>>\
        <p>Choose a preparation method before starting the cooking check.</p>\
        <<button "Choose a Method" "PrepareIngredient">><</button>>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><</button>>\
    </div>\
</div>

:: CookingResult
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<if $cookingResult>>\
        <div class="ticket-box">\
            <h3>$cookingResult.doneness!</h3>\
            <p>$cookingResult.ingredient was added to the prep tray.</p>\
            <p>Preparation method: $cookingResult.method</p>\
            <p>Method type: <<if $cookingResult.healthy>>Healthy<<else>>Unhealthy<</if>></p>\
        </div>\
    <<else>>\
        <p>Finish the cooking check before adding this ingredient to the tray.</p>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.advanceTutorialIngredient()>><</button>>\
    </div>\
</div>