:: Start
<div class="phone start-screen">\
    <h1>Food Truck</h1>\
    <p>Serve customers, prepare delicious meals, and grow your food truck.</p>\
    <div class="action-button start-actions">\
        <<button "Start Day" "ChooseMenu">><<run FoodTruck.endTutorial()>><<run FoodTruck.beginMenuSelection()>><</button>>\
        <<button "Play Tutorial" "TakeOrderScreen">><<run FoodTruck.startTutorial()>><</button>>\
        <<button "Toggle Debug Mode" "Start">><<run FoodTruck.toggleDebugMode()>><</button>>\
    </div>\
</div>\

:: ChooseMenu
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span>\
    </div>\
    <hr>\
    <h3 class="menu-title">Choose Today's Menu</h3>\
    <p class="menu-hint">Pick 3 ingredients. 3 more will be chosen at random, and customers will order from those 6.</p>\
    <p class="menu-count"><strong>Picked:</strong> <span id="menu-count">0</span> / 3</p>\
    <div class="menu-grid">\
        <<for _i = 0; _i < FoodTruck.ingredientDatabase.length; _i++>>\
            <button type="button" class="menu-pick-button" aria-pressed="false">\
                <span class="menu-pick-icon"><<print FoodTruck.ingredientDatabase[_i].img>></span>\
                <span class="menu-pick-name"><<print FoodTruck.ingredientDatabase[_i].name>></span>\
            </button>\
        <</for>>\
    </div>\
    <div class="action-button">\
        <button type="button" id="menu-start" disabled>Start Day</button>\
    </div>\
    <div class="passage-nav">\
        <<button "Exit to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
    </div>\
</div>

:: TakeOrderScreen
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <section class="customer-panel">\
        <div class="customer-window">\
            <div class="customer-face" role="img" aria-label="Placeholder customer face">🙂</div>\
        </div>\
    </section>\
    <div class="ticket-row">\
        <<for _t = 0; _t < $tickets.length; _t++>>\
            <<set _ticket = $tickets[_t]>>\
            <<capture _ticket>>\
            <div class="ticket-card">\
                <div class="ticket-cancel">\
                    <<button "✕" "TakeOrderScreen">><<run FoodTruck.cancelTicket(_ticket.id)>><</button>>\
                </div>\
                <h3 class="ticket-customer"><<print _ticket.custName>></h3>\
                <p class="ticket-dish"><<print _ticket.dishName>></p>\
                <ul class="ticket-ingredients">\
                    <<for _n range _ticket.requiredIngredients>><li><<print _n>></li><</for>>\
                </ul>\
                <div class="ticket-action">\
                    <<if $activeTicketId === _ticket.id>>\
                        <<if FoodTruck.canFulfillOrder()>>\
                            <<button "Fulfill Order">><<run FoodTruck.fulfillOrder()>><</button>>\
                        <<else>>\
                            <span class="ticket-status">In progress</span>\
                        <</if>>\
                    <<else>>\
                        <<button "Take Order" "TakeOrderScreen">><<run FoodTruck.selectOrder(_ticket.id)>><</button>>\
                    <</if>>\
                </div>\
                <div class="ticket-timer" role="img" aria-label="Time remaining"><div class="ticket-timer-fill"></div></div>\
            </div>\
            <</capture>>\
        <</for>>\
    </div>\
    <div class="prep-area compact">\
        <h4>Prep Tray</h4>\
        <div id="tray">\
            <<if $prepTray.length === 0>>\
                <em>No ingredients added yet.</em>\
            <<else>>\
                <<print $prepTray.join(" + ")>>\
            <</if>>\
        </div>\
    </div>\
    <div class="passage-nav">\
        <<button "Exit to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.startTutorialIngredients()>><</button>>\
    </div>\
</div>

:: DayTally
<div class="phone day-tally-screen">\
    <section class="day-tally-box">\
        <h2>Customer Satisfaction</h2>\
        <p class="tally-stars" aria-label="Customer satisfaction: $satisfactionScore out of 5 stars"><<print FoodTruck.starRating($satisfactionScore)>></p>\
        <h2>Healthiness</h2>\
        <p class="tally-stars" aria-label="Healthiness: $healthinessScore out of 5 stars"><<print FoodTruck.starRating($healthinessScore)>></p>\
        <p class="tally-tip"><<print FoodTruck.dayTips()>></p>\
        <div class="action-button">\
            <<if $tutorialMode>>\
                <<button "Return to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
            <<else>>\
                <<button "Choose Menu" "ChooseMenu">><<run FoodTruck.startNextDay()>><</button>>\
            <</if>>\
        </div>\
    </section>\
</div>

:: AssemblyStation
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<set _order = FoodTruck.getActiveOrder()>>\
    <<activeTicket>>\
    <div class="prep-area compact">\
        <div class="prep-header">\
            <h4>Prep Tray</h4>\
            <div class="tray-controls">\
                <<button "Clear Tray">><<run FoodTruck.clearTray()>><</button>>\
            </div>\
        </div>\
        <div id="tray">\
            <<if $prepTray.length === 0>>\
                <em>Tap ingredients to add them to the tray.</em>\
            <<else>>\
                <<print $prepTray.join(", ")>>\
            <</if>>\
        </div>\
    </div>\
    <<if _order>>\
    <div class="ingredient-shelf">\
        <h4>Ingredient Bins</h4>\
        <div class="ingredient-grid">\
            <<for _i = 0; _i < $todaysMenu.length; _i++>>\
                <<capture _i>>\
                <button type="button" class="ingredient-button">\
                    <span class="ingredient-icon"><<print $todaysMenu[_i].img>></span>\
                    <span class="ingredient-name"><<print $todaysMenu[_i].name>></span>\
                </button>\
                <</capture>>\
            <</for>>\
        </div>\
    </div>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Exit to Menu" "Start">><<run FoodTruck.endTutorial()>><</button>>\
        <<button "Order Window" "TakeOrderScreen">><<run FoodTruck.finishTutorialPrep()>><</button>>\
    </div>\
</div>

:: PrepareIngredient
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<activeTicket>>\
    <<if $pendingIngredient>>\
        <div class="ticket-box">\
            <h3>Prepare $pendingIngredient.name</h3>\
            <<if $pendingMethod>>\
                <p>Method: $pendingMethod.label</p>\
            <<else>>\
                <p>Choose a preparation method:</p>\
            <</if>>\
        </div>\
        <<if !$pendingMethod>>\
            <div class="method-options">\
                <<button `FoodTruck.methodLabel($methodOrder[0], 0)` "PrepareIngredient">><<run FoodTruck.chooseMethod($methodOrder[0])>><</button>>\
                <<button `FoodTruck.methodLabel($methodOrder[1], 1)` "PrepareIngredient">><<run FoodTruck.chooseMethod($methodOrder[1])>><</button>>\
            </div>\
        <<else>>\
            <div class="prep-feedback <<if $pendingMethod.type === 'healthy'>>healthy<<else>>unhealthy<</if>>" role="note">\
                <strong><<if $pendingMethod.type === "healthy">>Healthy choice!<<else>>Unhealthy choice<</if>></strong>\
                <p>$pendingMethod.reason</p>\
            </div>\
            <div id="prep-action" class="prep-action"></div>\
            <div class="action-button">\
                <button type="button" id="prep-continue" disabled>Continue to Cooking</button>\
            </div>\
        <</if>>\
    <<else>>\
        <p>Select an ingredient from the assembly station to prepare it.</p>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.returnToAssembly()>><</button>>\
    </div>\
</div>

:: CookingMinigame
<<run FoodTruck.updateCookingMarkerSpeed()>>
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<activeTicket>>\
    <<if $pendingIngredient && $pendingMethod && $prepActionDone>>\
        <div class="ticket-box">\
            <h3>Cooking $pendingIngredient.name</h3>\
            <p>Method: $pendingMethod.label</p>\
        </div>\
        <<if $cookingResult>>\
            <p>The ingredient has already been prepared.</p>\
            <<button "View Cooking Result" "CookingResult">><</button>>\
        <<else>>\
            <p class="skill-instructions">Stop the marker in the green section for a perfect cook.</p>\
            <div class="skill-track" role="img" aria-label="Cooking skill check: blue is raw, green is perfect, and red is overcooked">\
                <div class="skill-zone skill-zone-raw"></div>\
                <div class="skill-zone skill-zone-perfect"></div>\
                <div class="skill-zone skill-zone-overcooked"></div>\
                <div id="skill-marker" class="skill-marker"></div>\
            </div>\
            <div class="skill-legend">\
                <span>Raw</span>\
                <span>Perfect</span>\
                <span>Overcooked</span>\
            </div>\
            <div class="action-button">\
                <<button "Stop Cooking" "CookingResult">><<run FoodTruck.stopCooking()>><</button>>\
            </div>\
        <</if>>\
    <<else>>\
        <p>Choose a preparation method before starting the cooking check.</p>\
        <<button "Choose a Method" "PrepareIngredient">><</button>>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.returnToAssembly()>><</button>>\
    </div>\
</div>

:: CookingResult
<div class="phone">\
    <div class="HUD">\
        <span><strong>Day:</strong> $currentDay</span> |\
        <span><strong>Orders Left:</strong> $numOrders</span> |\
        <span><strong>Completed:</strong> $dayScore</span>\
    </div>\
    <hr>\
    <<if $cookingResult>>\
        <div class="cooking-result-box">\
            <h2 class="cooking-doneness">$cookingResult.doneness!</h2>\
            <div class="cooking-ingredient" role="img" aria-label="$cookingResult.ingredient"><<print $pendingIngredient.img>></div>\
            <p class="cooking-method-type <<if $cookingResult.healthy>>healthy<<else>>unhealthy<</if>>">\
                <<if $cookingResult.healthy>>Healthy<<else>>Unhealthy<</if>>\
            </p>\
            <p class="cooking-preparation">Preparation method: $cookingResult.method</p>\
        </div>\
    <<else>>\
        <p>Finish the cooking check before adding this ingredient to the tray.</p>\
    <</if>>\
    <div class="passage-nav">\
        <<button "Assembly Station" "AssemblyStation">><<run FoodTruck.advanceTutorialIngredient()>><</button>>\
    </div>\
</div>