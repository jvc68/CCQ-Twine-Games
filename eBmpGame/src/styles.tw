:: UserStylesheet [stylesheet]
* { box-sizing: border-box; }

body {
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
  background-color: #d1e8e8;
  margin: 0;
  padding: 1.5em 0;
}

#ui-bar { display: none; }

#story {
  margin: 0 auto;
  max-width: 380px;
  padding: 0;
}

/* Phone frame — compact, soft dark viridis teal */
.phone {
  background: linear-gradient(180deg, #440154 0%, #3b528b 50%, #21918c 100%);
  border-radius: 32px;
  padding: 25px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  color: white;
  position: relative;
  min-height: 660px;
  height: 660px;
  max-height: 100px;
  width: 100%;
  max-width: 100%;
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
}

.library {
  display: grid;
  grid-template-columns: auto auto auto auto ;
  gap: 18px;
  max-width: 300px;
  margin: 5% -2%;
}

.library button{ 
  border-radius:12px;
  background: snow;
  border: 2px solid darkgrey;
}

.desc {
  margin: 5px;
  padding: 5px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18),
  0px 0px 10px rgba(255, 255, 255, 1);
  
  border-radius:12px;
}

.reminderPopup {
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  background: linear-gradient(180deg, #440154 0%, #3b528b 50%, #21918c 100%);
  border-radius:12px;
  padding-left: 12px;
  padding: 10px;
  margin: 10px;
}

#ui-dialog-titlebar {
    display: none;
}

.fidgetIcon {
  width: 120px;
  aspect-ratio: 1 / 1;
  object-fit: contain;
}

.flButton {
  position: absolute;
  bottom: 4%;
}

.fidgetInterface {
  background: snow;
  border-radius: 12px;
  border: 1px solid black;
  padding: 8px;
  padding-left: 13px;
  align-content: center;
  text-align: center;
}

/*Drums */
.drums img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  border: none;
  image-rendering: pixelated;
}

.drums {
  background:transparent;
  border: none;
}

.drums:active {
  transform: scale(1.1);
}

/* Bass Drum (Bottom Center) */
.bass {
  position: absolute;
  border-radius: 50%;
  width: 136px;
  height: 65px;
  top: 47%;
  left: 30%;
}

/* Snare (Bottom Left) */
.snare {
  position: absolute;
  border-radius: 50%;
  width: 70px;
  height: 70px;
  top: 46%;
  left: 12.5%;
}

/* Hi-Hat (Top Left) */
.hihat {
  position: absolute;
  border-radius: 50%;
  width: 75px;
  height: 75px;
  top: 35%;
  left: 17%;
}

/* Top Tom (Upper-Mid Left) */
.topTom {
  position: absolute;
  border-radius: 50%;
  width: 60px;
  height: 60px;
  top: 38%;
  left: 36%;
}

/* Med Tom (Upper-Mid Right) */
.medTom {
  position: absolute;
  border-radius: 50%;
  width: 75px;
  height: 75px;
  top: 37%;
  left: 50.5%;
}

/* Low Tom / Floor Tom (Bottom Right) */
.lowTom {
  position: absolute;
  border-radius: 50%;
  width: 100px;
  height: 100px;
  top: 43%;
  left: 65%;
}

/* Crash Cymbal (Top Right) */
.crash {
  position: absolute;
  border-radius: 50%;
  width: 75px;
  height: 75px;
  top: 32%;
  left: 67%;
}

/*Bubble Wrap */
.bubble {
  border-radius: 32px;
  min-width: 25px;
  min-height: 25px
}

/*Light Switch */
.switch {
  background-color: darkgrey;
  height: 10px;
  width: 10px;
  
}

.switchImg {
  width: 55%;
  height: 55%;
  position: absolute;
  left: 22%;
  top: 24%;
  padding: -20px;
}

/*Control Panel */


.row{
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  padding: 14px;
  justify-items: center; 
  
  
}

.light {
  border-radius: 50px;
  background-color: white;
  border: 1px solid black;
  box-shadow: 
  0px 0px 10px rgba(255, 255, 255, 1),
  4px 4px 10px rgba(255, 255, 255, 1),
  -4px -4px 10px rgba(255, 255, 255, 1);
  width: 40%;
  aspect-ratio: 1 / 1;
  text-align: center;
}

.lightButton {
  border-radius: 50%;
  background-color: red;
  border: 3px double darkred;
  width: 65%;
  aspect-ratio: 1 / 1;
  
}

.flip {
  display: block;
  background:transparent;
  border: none;

  height: .1px;
  width: .1px;
  padding:20px;
}

.flip:hover {
  background:transparent;
  border: none;
}

.flipImg {
  position: relative;
  left: -12px;
  top: -12px;
  transition: filter 0.1s ease;
}

.flipImg:hover {
  filter: brightness(60%);
}

.flipImg:active {
  transform: translate(0px, 2px);
}

.flipped {
  position: relative;
  left: -12px;
  top: -12px;
  transition: filter 0.1s ease;
  transform: scaleY(-1);
}

.flipped:hover {
  filter: brightness(60%);
}

.flipped:active {
  transform: scaleY(-1) translate(0px, -2px);

}
