:: UserStylesheet [stylesheet]
/* ============================================================
   Daily archer — visual stylesheet
   Arial font, click handler on cells (no passage refresh on
   click), compact phone height.

   CardioCareQuest viridis palette (canonical across all games):
     #440154  deep purple   — phone gradient stop 1
     #3b528b  blue          — phone gradient stop 2
     #21918c  teal          — phone gradient stop 3 / marked cell
     #5ec962  green          — win banner / success
     #fde725  yellow         — title / FREE / primary CTA
     #f4f1d8  cream          — page background
   2026-05-10: phone gradient + dark-text accent (#1a1a1a) replaced
   to align with viridis anchor stops.
   ============================================================ */

* { box-sizing: border-box; }

body {
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
  background-color: #d1e8e8;
  margin: 0;
  padding: 1.5em 0;
}

#ui-bar { display: none; }

#story {
  margin: 0 auto;
  max-width: 380px;
  padding: 0;
}

/* Phone frame — compact, soft dark viridis teal */
.phone {
  background: linear-gradient(180deg, #440154 0%, #3b528b 50%, #21918c 100%);
  border-radius: 32px;
  padding: 25px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  color: white;
  position: relative;
  min-height: 660px;
  max-height: 100px;
  width: 100%;
  max-width: 100%;
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
}

.flButton {
  position: absolute;
  bottom: 4%;
}

.fidgetInterface {
  background: lightgrey;
  border-radius: 12px;
  border: 1px solid black;
  padding: 8px;
  padding-left: 13px;
  align-content: center;
  text-align: center;
}

.bubble {
  border-radius: 32px;
  min-width: 25px;
  min-height: 25px
}

.switch {
  
  padding: 100px;
  background-color: darkgrey;
  border-radius: 100px;
  min-width: 75px;
  min-height: 75px

}

/*Control Panel */

.controlPanel {
  background-color: #a7a69b;
}

.row{
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  padding: 10px;
  justify-items: center; 
  
}

.light {
  border-radius: 50px;
  background-color: white;
  border: 1px solid black;
  box-shadow: 
  0px 0px 10px rgba(255, 255, 255, 1),
  4px 4px 10px rgba(255, 255, 255, 1),
  -4px -4px 10px rgba(255, 255, 255, 1);
  width: 18px;
  height: 18px;
  text-align: center;
}

.lightButton {
  border-radius: 50px;
  background-color: red;
  width: 35px;
  height: 35px;
  
}

.flip {
  display: block;
}
