:: StoryTitle
While You Wait

:: StoryData
{
  "ifid": "637D0CD9-6182-4ACE-9AF0-B6FB94AB090A",
  "format": "SugarCube",
  "format-version": "2.37.3",
  "start": "Fidget Library",
  "zoom": 1
}

:: StoryInit {"position": "100,100", "size": "100,100"}
<<run setInterval(setup.updateTimer, 1000)>>
<<=setup.formattedTime = "02:00">>
<<run  
  Dialog.setup("Important Reminder", "reminderPopup");
  Dialog.wiki(`
  Welcome to While You Wait!\n
  This game is meant to help you relax before you take your blood pressure measurement. Relaxing is important as it makes sure your reading is accurate.\n
  Please make sure to play the game with the hand of the arm that you are NOT going to use for taking your measurement.\n
  With your other arm, keep it relaxed and have the hand open, and take calming breaths throughout the game.\n
  We suggest you wait 2 minutes before taking your measurement, but feel free to do so at any time.\n
  Enjoy!
  `);
  Dialog.open();>> 

:: Home
<div class="phone">Time Spent: <span id="timer"><<=setup.formattedTime>></span>
<span id="currentFidget">Switch</span>
<div id="blankSpace"></div>
<div class="fidgetInterface" id="container"></div>\
<div class="desc" id="desc"></div>\
<div class="options" id="postContainer"></div>
  <<done>><<run setup.populateFidget()>><</done>>
  <div class="flButton"> 
    <<button "Fidget Library" "Fidget Library">><</button>>
  </div>
</div>

:: Fidget Library
<div class="phone">Fidget Library
Time Spent: <span id="timer"><<=setup.formattedTime>></span>
  <div class="library">
    <<button "<img class='fidgetIcon' src='../../img/measurement/bubbleWrap.png'>">><<run setup.swapFidget("bubbleWrap")>> <</button>>
    <<button "<img class='fidgetIcon' src='../../img/measurement/switchOn.png'>">><<run setup.swapFidget("switch")>> <</button>>
    <<button "<img class='fidgetIcon' src='../../img/measurement/controlPanel.png'>">><<run setup.swapFidget("controlPanel")>> <</button>>
    <<button "<img class='fidgetIcon' src='../../img/measurement/drums.png'>">><<run setup.swapFidget("drums")>> <</button>>
  </div> 

</div>