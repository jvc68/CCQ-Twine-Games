:: StoryStylesheet [stylesheet]

* {
    box-sizing: border-box;
}

body {
    font-family: 'Atkinson Hyperlegible', system-ui, -apple-system,
                 "Segoe UI", sans-serif;
    background-color: #d1e8e8;
    margin: 0;
    padding: 1.5em 0;
}

/* Hide SugarCube's sidebar */
#ui-bar {
    display: none;
}

/* Phone frame — compact, soft dark viridis teal */
#story {
  background: linear-gradient(180deg, #440154 0%, #3b528b 50%, #21918c 100%);
  border-radius: 32px;
  padding: 25px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  color: white;
  position: relative;
  min-height: 660px;
  max-height: 100px;
  width: 100%;
  max-width: 340px;
  margin: 0 auto;
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
}

.activity-message {
    background: rgba(255, 255, 255, 0.15);
    font-size: 14px;
}

.activity-page h2 {
    font-size: 10px;
    margin: 12px 0 7px;
    padding-bottom: 5px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
}

.activity-card {
    background: white;
    color: #172033;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
}

.activity-card h3 {
    font-size: 15px;
    margin: 0 0 4px;
}

.activity-card p {
    font-size: 13px;
    line-height: 1.35;
}

.activity-card a {
    display: inline-block;
    background: #b5f5d0;
    color: #173c2b;
    padding: 8px 11px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
}

.activity-card a:hover {
    background: #8cebb8;
}

.activity-locked {
    color: #687385;
    font-size: 13px;
    font-style: italic;
}

.completed {
    border-left: 4px solid #00c878;
}

.completed-label {
    color: #16834f;
    font-size: 13px;
    font-weight: bold;
}

.back-link {
    margin: 12px 0 4px;
    text-align: center;
    font-size: 14px;
}


/* for popup window styling */

.answer-buttons button {
    display: block;
    width: 100%;
    padding: 12px;
    margin: 10px 0;
    border: none;
    border-radius: 10px;
    background: lightblue;
    color: black;
    font-size: 16px;
    text-align: left;
    cursor: pointer;
}

.answer-buttons button:hover {
    background: skyblue;
}

/* Make the popup match the mobile game screen */

#ui-dialog {
    width: 390px;
    max-width: 100vw;
    box-sizing: border-box;
    margin: 0 auto;
}

#ui-dialog-body {
    box-sizing: border-box;
    width: 100%;
    padding: 20px;
}



/* Home screen */
.home-screen {
    text-align: center;
    color: white;
}

.home-screen h1 {
    font-size: 24px;
    margin: 4px 0 4px;
}

.home-screen p {
    font-size: 14px;
    margin: 4px 0;
}

.body-map {
    position: relative;
    width: 100%;
    max-width: 340px;
    height: 290px;
    margin: 8px auto 10px;
}

/* Five topic circles */
.body-circle {
    position: absolute;
    width: 85px;
    height: 85px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 8px;
    font-size: 12px;
    font-weight: bold;
    text-align: center;
    border: 3px solid white;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
}

/* Arrange the circles like a human body */
/* Brain — top centre */
.body-circle.head {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: #f5c2e7;
}

/* Lungs — middle left */
.body-circle.left {
    top: 100px;
    left: 15%;
    background: #89c2d9;
}

/* Heart — middle right */
.body-circle.center {
    top: 100px;
    left: 85%;
    transform: translateX(-100%);
    background: #f08080;
}

/* Blood vessels — bottom left */
.body-circle.right {
    top: 200px;
    left: 15%;
    background: #8bd3a8;
}

/* Blood cells — bottom right */
.body-circle.legs {
    top: 200px;
    left: 85%;
    transform: translateX(-100%);
    background: #f4c95d;
}
/* Make the links fill each circle */
.body-circle a {
    color: #172033;
    text-decoration: none;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    line-height: 1.3;
}

.body-circle:hover {
    filter: brightness(1.1);
    transform: scale(1.05);
}

.body-circle.head:hover {
    transform: translateX(-50%) scale(1.05);
}

.body-circle.center:hover,
.body-circle.legs:hover {
    transform: translateX(-100%) scale(1.05);
}

.home-hint {
    margin-top: 10px;
    font-style: italic;
}

/* Blood Vessels activity menu */
.blood-vessels-menu {
    text-align: center;
    margin: 0;
    padding: 0;
}

.blood-vessels-menu h1 {
    font-size: 21px;
    margin: 0 0 3px;
    line-height: 1.2;
}

.blood-vessels-menu .activity-message {
    font-size: 12px;
    line-height: 1.2;
    padding: 5px 7px;
    margin: 3px 0 6px;
}

/* Completed and New tabs */
.activity-tabs {
    display: flex;
    gap: 5px;
    margin-bottom: 20px;
}

.activity-tabs a {
    flex: 1;
    padding: 3px 5px;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 10px;
}

/* Highlight the currently selected tab */
.activity-page a.active {
    background-color: rgba(255, 255, 255, 0.49);
    color: white;
    font-weight: bold;
    border-radius: 6px;
}

/* Make text smaller in the activity interface */
#activity-content h4 {
    font-size: 1.05em;
    line-height: 1.4;
}

#activity-content p {
    font-size: 0.9em;
    line-height: 1.5;
}

#activity-content h4 + p {
    margin-top: 0.4em;
}

/* Style the answer feedback popup */
#ui-dialog {
    width: 350px;
    max-width: 500px;
    margin: 0 auto;
    box-sizing: border-box;

    border: none;
    border-radius: 18px;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
}


/* Style the popup title bar */
#ui-dialog-titlebar {
    background-color: #3b528b;
    color: white;
    padding: 16px 20px;
    font-size: 1.3em;
    font-weight: bold;
    border-bottom: none;
}

/* Style the popup message area */
#ui-dialog-body {
    background-color: #F0F8FA;
    color: #29434E;
    padding: 24px;
    font-size: 1.05em;
    line-height: 1.6;
}

/* Style buttons inside the popup */
#ui-dialog-body button {
    background-color: #4A90A4;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 10px 20px;
    font-size: 1em;
    cursor: pointer;
}

/* Change button appearance when hovered */
#ui-dialog-body button:hover {
    background-color: #357588;
}

#activity-content .answer-buttons button {
    font-size: 0.85em;
    line-height: 1.4;
    padding: 8px 12px;
}

#activity-content #activity-progress {
    font-size: 0.85em;
    line-height: 1.5;
}


.blood-vessels-menu .activity-card {
    margin: 0;
    padding: 6px 8px;
    text-align: left;
    border-radius: 9px;
}

.blood-vessels-menu .activity-card h3 {
    font-size: 13px;
    margin: 0 0 2px;
    line-height: 1.2;
}

.blood-vessels-menu .activity-card p {
    font-size: 11px;
    line-height: 1.2;
    margin: 2px 0 3px;
}

.blood-vessels-menu .activity-card a {
    padding: 5px 7px;
    font-size: 11px;
}


.activity-pagination a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 25px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.22);
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.blood-vessels-menu .back-link {
    margin: 4px 0 0;
    font-size: 11px;
}



.activity-list {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
    margin-top: 10px;
}

.activity-pagination {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin: 4px 0 0;
    padding: 0;
    margin-top: 10px;
}

/* TUTORIAL STYLING */
/* TUTORIAL */

.tutorial-panel {
    max-width: 650px;
    margin: 5px auto;
    padding: 5px;
    text-align: center;
}

.tutorial-icon {
    font-size: 3rem
}

.tutorial-panel ul {
    margin: 5px auto;
    padding-left: 20px;
}

.tutorial-panel li {
    margin-bottom: 2px;
    line-height: 1.2;
}

.tutorial-panel h2 {
    margin-top: 0;
}

.tutorial-panel ul {
    display: inline-block;
    text-align: left;
    margin: 10px auto 20px;
}

.tutorial-panel li {
    margin-bottom: 8px;
}

.tutorial-navigation {
    margin-top: 25px;
}

.tutorial-navigation button,
.tutorial-button {
    padding: 12px 25px;
    border: none;
    border-radius: 10px;
    background: #18584f;
    color: white;
    font-size: 1em;
    font-weight: bold;
    cursor: pointer;
}
.scenario-menu .tutorial-button {
    padding: 7px 14px;
    font-size: 13px;
    border-radius: 8px;
}

.tutorial-navigation button:hover,
.tutorial-button:hover {
    background: #24766b;
}

.tutorial-home-button {
    margin: 25px auto 10px;
    text-align: center;
}

.tutorial-home-button button {
    padding: 14px 24px;
    border: none;
    border-radius: 12px;
    background: #18584f;
    color: white;
    font-size: 1.1em;
    font-weight: bold;
    cursor: pointer;
}

.tutorial-home-button button:hover {
    background: #24766b;
}

.tutorial-home-button p {
    margin-top: 10px;
    font-size: 0.9em;
}

/* Body systems connected to the selected scenario */
.body-circle.scenario-highlighted {
    opacity: 1;
    border: 4px solid #FFD700;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.8);
    z-index: 2;
}

/* Keep highlighted circles in their original positions */
.body-circle.head.scenario-highlighted {
    transform: translateX(-50%) scale(1.08);
}

.body-circle.center.scenario-highlighted,
.body-circle.legs.scenario-highlighted {
    transform: translateX(-100%) scale(1.08);
}

.body-circle.left.scenario-highlighted,
.body-circle.right.scenario-highlighted {
    transform: scale(1.08);
}

/* Body systems not connected to the selected scenario */
.body-circle.scenario-dimmed {
    opacity: 0.35;
    filter: grayscale(80%);
}

#scenario-body-map button {
    margin: 2px auto;
}

.scenario-video {
    display: block;
    width: 100%;
    max-width: 500px;
    max-height: 35vh;
    object-fit: contain;
    margin: 8px auto;
    border-radius: 12px;
}

.scenario-menu .activity-card {
    text-align: center;
    padding: 5px;
    background: #ffffff;
    border-radius: 15px;
    color: #000000;
    overflow: hidden;
}

.scenario-menu .activity-card h3 {
    margin: 0 0 4px;
    padding: 0;
    color: #000000;
}

.start-buttons button {
    padding: 8px 12px;
    font-size: 12px;
    border-radius: 8px;
    flex: 1;
}

.start-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 15px auto;
}