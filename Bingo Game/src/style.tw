:: UserStylesheet [stylesheet]
/* ============================================================
   Bingo Game — visual stylesheet
   Phone-frame UI, large food cards.

   CardioCareQuest viridis palette (canonical across all games):
     #440154  deep purple   — phone gradient stop 1
     #3b528b  blue          — phone gradient stop 2
     #21918c  teal          — phone gradient stop 3 / nutrient mid
     #5ec962  green          — nutrient bright / verdict good (#1a5a1f deep)
     #fde725  yellow         — primary CTA / attention
     #f4f1d8  cream          — page background
   The sludge meter intentionally stays warm (#f0a020 → #d04020) —
   it's a semantic clinical warning, same convention Vascular
   Village uses for BP stage-1/2 zones. The verdict-bad text color
   #8a2025 follows the same warm-warning convention. Everything
   else follows viridis stops.
   ============================================================ */

* { box-sizing: border-box; }

body {
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
  background-color: #d1e8e8;
  margin: 0;
  padding: 1.5em 0;
}

#ui-bar { display: none; }

#story {
  margin: 0 auto;
  max-width: 380px;
  padding: 0;
}

/* Phone frame — compact, soft dark viridis teal */
.phone {
  background: linear-gradient(to top, #440154, #3b528b, #21918c);
  border-radius: 32px;
  padding: 25px;
  overflow: hidden;
  box-shadow: 0 8px 30px rgba(0,0,0,0.18);
  color: white;
  position: relative;
  min-height: 660px;
  max-height: 100px;
  width: 100%;
  max-width: 100%;
  font-family: 'Atkinson Hyperlegible', system-ui, -apple-system, "Segoe UI", sans-serif;
}

.navigation {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  height: 50px;
  margin-left: -25px;
  margin-right: -25px;
  margin-bottom: -25px;
}

.navigation button {
  flex: 1;
  box-sizing: border-box;
  margin: 0;
  border: 1px solid darkblue;
  border-radius: 2px;
  padding-bottom: 200px;
}

.bingo-game {
    max-width: 650px;
    margin: 20px auto;
    font-family: Arial, sans-serif;
    text-align: center;
}

.bingo-board {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 5px;
    margin: 20px 0;
}

.bingo-header {
    background: #5ec962;
    color: black;
    font-size: 1.5rem;
    font-weight: bold;
    padding: 12px 4px;
    border-radius: 5px;
}

.bingo-cell {
    display: flex
    min-width: 0;
    aspect-ratio: 1 / 1;
    border: 2px solid #315c49;
    border-radius: 5px;
    background: #f4f1d8;
    color: #222222;
    font-size: 1.3rem;
    font-weight: bold;
    align-items: center
    justify-content: center
}

.bingo-cell.marked {
    background: #fde725;
    color: #153b27;
    border-color: #315c49;
}

.bingo-cell.free {
    background: #5ec962;
    cursor: default;
    font-size: 1.3rem;
}

#bingo-status {
    min-height: 30px;
    font-size: 1.1rem;
    font-weight: bold;
    color: #315c49;
}

#bingo-reset {
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    background: #315c49;
    color: white;
    font-size: 1rem;
    cursor: pointer;
}

#bingo-reset:hover {
    background: #244435;
}

@media (max-width: 450px) {
    .bingo-cell {
        font-size: 1rem;
    }

    .bingo-header {
        font-size: 1.2rem;
    }
}

.bingo-board {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-flow: row;
    gap: 5px;
    line-height: normal;
}

.bingo-header,
.bingo-cell {
    width: 100%;
    min-width: 0;
    margin: 0;
}

.screen {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.task-box {
    background-color: #f4f1d8;
    color: black;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 20rem;
    border-radius: 25px;
}

.bingo-position {
    background-color: #f4f1d8;
    color: black;
    border-radius: 50%;
    height: 75px;
    width: 75px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}