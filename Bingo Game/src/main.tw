:: StoryTitle
Medical Bingo

:: StoryData
{
    "ifid": "5B772005-6875-443E-91B8-82044C3A36EC",
	"format": "SugarCube",
	"format-version": "2.30.0",
    "start": "Home",
    "zoom": 1
}

:: StoryInit
<<set $markedPositions = []>>

:: Home
<div class="phone">
    <div class="screen">
        <h1>Welcome to Blood Pressure Bingo</h1>
        <<button [["See Bingo Board" | BingoBoard]]>><</button>>
        <<button [["See Tasks" | Tasks]]>><</button>>
    </div>
</div>

:: Tasks
<div class="phone">
    <div class="screen">
        <h1>Tasks List</h1>
        <div class="task-box">
            <h4>I went for a walk today!</h4>
            <<button [["Complete" | BingoNumber]]>><</button>>
        </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: BingoNumber
<div class="phone">
    <div class="screen">
        <h1>Congratulations!</h1>
        <div class="bingo-position">
            <h4>B 35</h4>
        </div>
        <<button "Lock it in">>
            <<run BingoGame.markPosition()>>
            <<goto "LockIn">>
        <</button>>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: LockIn
<div class="phone">
    <div class="screen">
        <h1>True or False?</h1>
        <div class="task-box">
            <h4>Diuretics, aka water pills, help the body eliminate excess salt and water.</h4>
            <<button [["True" | Explanation Positive]]>><</button>>
            <<button [["False" | Explanation Negative]]>><</button>>
        </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: Explanation Positive
<div class="phone">
    <div class="screen">
        <h1>Good Job!</h1>
        <div class="task-box">
            <h4>Diuretics do help the body eliminate excess salt and water. This in turn means they are effective at reducing blood pressure and some (such as thiazides and loop diuretics) are used for the treatment of high blood pressure (hypertension).</h4>
            <<button [["View Board" | BingoBoard]]>><</button>>
        </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: Explanation Negative
<div class="phone">
    <div class="screen">
        <h1>Not Quite</h1>
        <div class="task-box">
            <h4>Diuretics do help the body eliminate excess salt and water. This in turn means they are effective at reducing blood pressure and some (such as thiazides and loop diuretics) are used for the treatment of high blood pressure (hypertension).</h4>
            <<button [["View Board" | BingoBoard]]>><</button>>
        </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: BingoBoard
<<nobr>>
    <div class="phone">
        <div class="bingo-game">
            <div class="bingo-board">
                <div class="bingo-header">B</div>
                <div class="bingo-header">I</div>
                <div class="bingo-header">N</div>
                <div class="bingo-header">G</div>
                <div class="bingo-header">O</div>

                <<if $markedPositions.includes(0)>>
                    <div class="bingo-cell marked" data-index="0"><p>35</p></div>
                <<else>>
                    <div class="bingo-cell" data-index="0"><p>35</p></div>
                <</if>>
                <div class="bingo-cell" data-index="1"><p>49</p></div>
                <div class="bingo-cell" data-index="2"><p>16</p></div>
                <div class="bingo-cell" data-index="3"><p>98</p></div>
                <div class="bingo-cell" data-index="4"><p>51</p></div>

                <div class="bingo-cell" data-index="5"><p>36</p></div>
