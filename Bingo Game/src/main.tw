:: StoryTitle
Medical Bingo

:: StoryData
{
    "ifid": "5B772005-6875-443E-91B8-82044C3A36EC",
	"format": "SugarCube",
	"format-version": "2.30.0",
    "start": "Home",
    "zoom": 1
}

:: StoryInit
<<set $customTasks = []>>

<<set $selectedPosition = -1>>
<<set $randomQuestion = null>>

<<run BingoGame.syncToStory()>>
<<set $tasks = [
    { task: "I went for a walk today!", status: "incomplete" },
    { task: "I ate a healthy meal today!", status: "incomplete" },
    { task: "I took my medication!", status: "incomplete" },
    { task: "I tracked my blood pressure!", status: "incomplete" },
    { task: "I learned something today!", status: "incomplete" }
]>>
<<set $bingoNumbers = [
    "B 35", "I 49", "N 16", "G 98", "O 51",
    "B 36", "I 54", "N 72", "G 39", "O 48",
    "B 18", "I 22", null, "G 93", "O 14",
    "B 44", "I 68", "N 9", "G 64", "O 86",
    "B 52", "I 37", "N 50", "G 58", "O 91"
]>>
<<set $questions = [
    { question: "Diuretics, aka water pills, help the body eliminate excess salt and water.",
        explanation: "Diuretics do help the body eliminate excess salt and water. This in turn means they are effective at reducing blood pressure and some (such as thiazides and loop diuretics) are used for the treatment of high blood pressure (hypertension).",
        status: "unused" },
    { question: "Isometric exercises are the most effective workouts for managing hypertension.",
        explanation: "Isometric exercises are the most effective workout for manaing hypertension. Researchers found that isometric exercise was 98% effective in reducing high blood pressure.",
        status: "unused" },
    { question: "Dehydration can cause hypertension.",
        explanation: "Dehydration can cause blood to get thicker and reduces blood volume which in turn can increase blood pressure.",
        status: "unused" },
    { question: "You can still have hypertension, even if you don't experience symptoms.",
        explanation: "This is often why it is called the \'silent killer\' because many people can have hypertension without knowing. This is why it is important to do often screenings.",
        status: "unused" },
    { question: "Just because your blood pressure is back to normal, you should continue taking your hypertension medication.",
        explanation: "When you blood pressure returns to normal, it just means that the medications are working, not that your hypertension is cured. Stopping medication can cause blood pressure to rise again.",
        status: "unused" }
]>>
:: Home
<div class="phone">\
    <div class="screen">\
        <h1 class="welcome-msg">Welcome to Blood Pressure Bingo</h1>\
        <div class="start-cont">\
            <button data-passage="BingoBoard" class="start-btn">View Board</button>\
        </div>\
    </div>\
</div>\

:: Tasks
<<set $availableTasks = BingoGame.getAvailableTasks($tasks)>>\
<<set $randomTask1 = null>>\
<<set $randomTask2 = null>>\
<<set $randomTask3 = null>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask1 = BingoGame.getRandomElement($availableTasks)>>\
    <<run $availableTasks.splice($availableTasks.indexOf($randomTask1), 1)>>\
<</if>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask2 = BingoGame.getRandomElement($availableTasks)>>\
    <<run $availableTasks.splice($availableTasks.indexOf($randomTask2), 1)>>\
<</if>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask3 = BingoGame.getRandomElement($availableTasks)>>\
<</if>>\
<div class="phone">\
    <div class="screen">\
        <h1>Tasks List</h1>\


            <div class="task-list">\
                <<if $randomTask1>>\
                    <div class="task-content">\
                        <h4><<print $randomTask1.task>></h4>\
                        <<button "Complete">>\
                            <<run BingoGame.completeTask($randomTask1.id)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
                <<if $randomTask2>>\
                    <div class="task-content">\
                        <h4><<print $randomTask2.task>></h4>\
                        <<button "Complete">>\
                            <<run BingoGame.completeTask($randomTask2.id)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
                <<if $randomTask3>>\
                    <div class="task-content">\
                        <h4><<print $randomTask3.task>></h4>\
                        <<button "Complete">>\
                            <<run BingoGame.completeTask($randomTask3.id)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
            </div>\
            <div class="add-task">\
                <h4>Create Your Own Task</h4>\
                <input
                    type="text"
                    id="customTaskInput"
                    placeholder="Enter your task..."
                >\
                <<button "Add Task">>\
                    <<set $newTask = document.getElementById("customTaskInput").value>>\
                    <<if $newTask.trim() !== "">>\
                        <<run BingoGame.addCustomTask($newTask)>>\
                        <<goto "Tasks">>\
                    <<else>>\
                        <<run alert("Please enter a task.")>>\
                    <</if>>\
                <</button>>\
            </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: BingoNumber
<div class="phone">\
    <div class="screen">\
        <h1>Congratulations!</h1>\
        <div class="bingo-position">\
            <h4>\
                <<print $bingoNumbers[$selectedPosition]>>\
            </h4>\
        </div>\
        <p>You've earned this bingo number!</p>\
        <<button "Lock it in">>\
            <<goto "LockIn">>\
        <</button>>\
        <<button "Exit to Home">>\
            <<goto "Home">>\
        <</button>>\
    </div>\
</div>\

:: LockIn
<<set $randomQuestion = BingoGame.getRandomQuestion($questions)>>\
<div class="phone">\
    <div class="screen">\
        <h1>True or False?</h1>\
        <<if $randomQuestion>>\
            <div class="task-box">\
                <h4>\
                    <<print $randomQuestion.question>>\
                </h4>\
                <<button "True">>\
                    <<goto "Explanation Positive">>\
                <</button>>\
                <<button "False">>\
                    <<goto "Explanation Negative">>\
                <</button>>\
            </div>\
        <<else>>\
            <h4>You've answered all available questions!</h4>\
            <<button "View Board">>\
                <<goto "BingoBoard">>\
            <</button>>\
        <</if>>\
        <<button "Exit to Home">>\
            <<goto "Home">>\
        <</button>>\
    </div>\
</div>\

:: Explanation Positive
<div class="phone">\
    <div class="screen">\
        <h1>Good Job!</h1>\
        <div class="task-box">\
            <h4><<print $randomQuestion.explanation>></h4>\
            <<button "View Board">>\
                <<run BingoGame.markPosition($selectedPosition)>>\
                <<if BingoGame.checkBingo()>>\
                    <<goto "Congratulations">>\
                <<else>>\
                    <<goto "BingoBoard">>\
                <</if>>\
            <</button>>\
        </div>\
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: Explanation Negative
<div class="phone">
    <div class="screen">
        <h1>Not Quite</h1>
        <div class="task-box">
            <h4><<print $randomQuestion.explanation>></h4>
            <<button "View Board">>\
                <<run BingoGame.markPosition($selectedPosition)>>\
                <<if BingoGame.checkBingo()>>\
                    <<goto "Congratulations">>\
                <<else>>\
                    <<goto "BingoBoard">>\
                <</if>>\
            <</button>>\
        </div>
        <<button [["Exit to Home" | Home]]>><</button>>
    </div>
</div>

:: Congratulations
<div class="phone">\
    <div class="screen">\
        <h1>Congratulations!</h1>\
        <div class="task-box">\
            <h2>YOU GOT BINGO!</h2>\
            <p>
                You successfully completed a winning
                combination on your bingo board!
            </p>\
            <p>
                Great job taking steps toward a
                healthier lifestyle!
            </p>\
        </div>
        <<button "View My Board">>\
            <<goto "BingoBoard">>\
        <</button>>\
        <<button "Exit to Home">>\
            <<goto "Home">>\
        <</button>>\
    </div>
</div>

:: BingoBoard
<<nobr>>
