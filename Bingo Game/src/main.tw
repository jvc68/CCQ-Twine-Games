                <div class="bingo-cell" data-index="7"><p>72</p></div>
                <div class="bingo-cell" data-index="8"><p>39</p></div>
                <div class="bingo-cell" data-index="9"><p>48</p></div>

                <div class="bingo-cell" data-index="10"><p>18</p></div>
                <div class="bingo-cell" data-index="11"><p>22</p></div>
                <div class="bingo-cell free marked" data-index="12" disabled><p>FREE</p></div>
                <div class="bingo-cell" data-index="13"><p>93</p></div>
                <div class="bingo-cell" data-index="14"><p>14</p></div>

                <div class="bingo-cell" data-index="15"><p>44</p></div>
                <div class="bingo-cell" data-index="16"><p>68</p></div>
                <div class="bingo-cell" data-index="17"><p>9</p></div>
                <div class="bingo-cell" data-index="18"><p>64</p></div>
                <div class="bingo-cell" data-index="19"><p>86</p></div>

                <div class="bingo-cell" data-index="20"><p>52</p></div>
