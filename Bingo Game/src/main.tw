                <div class="bingo-cell" data-index="22"><p>50</p></div>
                <div class="bingo-cell" data-index="23"><p>58</p></div>
                <div class="bingo-cell" data-index="24"><p>91</p></div>
            </div>
            <p class="bingo-status"> Good Luck!</p>
            <button class="bingo-reset" onclick="BingoGame.resetBoard()">Reset Board</button>
            <<button [["Exit to Home" | Home]]>><</button>>
        </div>
    </div>
<</nobr>>