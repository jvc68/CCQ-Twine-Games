:: StoryTitle
Medical Bingo

:: StoryData
{
    "ifid": "5B772005-6875-443E-91B8-82044C3A36EC",
	"format": "SugarCube",
	"format-version": "2.30.0",
    "start": "Home",
    "zoom": 1
}

:: StoryInit
<<set $tasks = BingoData.tasks>>
<<set $customTasks = []>>
<<set $questions = BingoData.questions>>

<<set $bingoNumbers = []>>

<<set $selectedPosition = -1>>
<<set $randomQuestion = null>>

<<run BingoGame.syncToStory()>>

:: Home
<div class="phone">\
    <div class="screen">\
        <h1 class="welcome-msg">Welcome to Blood Pressure Bingo</h1>\
        <div class="start-cont">\
            <button data-passage="BingoBoard" class="start-btn">View Board</button>\
        </div>\
    </div>\
</div>\

:: Tasks
<<set $availableTasks = BingoGame.getAvailableTasks($tasks)>>\
<<set $randomTask1 = null>>\
<<set $randomTask2 = null>>\
<<set $randomTask3 = null>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask1 = BingoGame.getRandomElement($availableTasks)>>\
    <<run $availableTasks.splice($availableTasks.indexOf($randomTask1), 1)>>\
<</if>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask2 = BingoGame.getRandomElement($availableTasks)>>\
    <<run $availableTasks.splice($availableTasks.indexOf($randomTask2), 1)>>\
<</if>>\
<<if $availableTasks.length > 0>>\
    <<set $randomTask3 = BingoGame.getRandomElement($availableTasks)>>\
<</if>>\
<div class="phone">\
    <div class="screen">\
        <h1>Tasks List</h1>\
        <details class="recent-tasks-dropdown">\
            <summary>Recently Completed Tasks</summary>\
            <div class="recent-tasks-list">\
                <<if $recentCompletedTasks.length > 0>>\
                    <<for _i = 0; _i < $recentCompletedTasks.length; _i++>>\
                        <div class="recent-task-item">\
                            <span>✓</span>\
                            <<print $recentCompletedTasks[_i]>>\
                        </div>\
                    <</for>>\
                <<else>>\
                    <p>No completed tasks yet!</p>\
                <</if>>\
            </div>\
        </details>\
            <div class="task-list">\
                <<if $randomTask1>>\
                    <div class="task-content">\
                        <h4><<print $randomTask1.task>></h4>\
                        <<button "Mark Complete">>\
                            <<run BingoGame.completeTask($randomTask1.id, $randomTask1.task)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
                <<if $randomTask2>>\
                    <div class="task-content">\
                        <h4><<print $randomTask2.task>></h4>\
                        <<button "Mark Complete">>\
                            <<run BingoGame.completeTask($randomTask2.id, $randomTask2.task)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
                <<if $randomTask3>>\
                    <div class="task-content">\
                        <h4><<print $randomTask3.task>></h4>\
                        <<button "Mark Complete">>\
                            <<run BingoGame.completeTask($randomTask3.id, $randomTask3.task)>>\
                            <<goto "BingoNumber">>\
                        <</button>>\
                    </div>\
                <</if>>\
            </div>\
            <div class="add-task">\
                <h4>Create Your Own Task</h4>\
                <input
                    type="text"
                    id="customTaskInput"
                    placeholder="Enter your task..."
                >\
                <<button "Add Task">>\
                    <<set $newTask = document.getElementById("customTaskInput").value>>\
                    <<if $newTask.trim() !== "">>\
                        <<run BingoGame.addCustomTask($newTask)>>\
                        <<goto "Tasks">>\
                    <<else>>\
                        <<run alert("Please enter a task.")>>\
                    <</if>>\
                <</button>>\
            </div>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>\
</div>\

:: BingoNumber
<div class="phone">\
    <div class="screen">\
        <h1>Congratulations!</h1>\
        <div class="task-box">\
            <h4>You've completed your task!</h4>\
            <p>Answer the following question to reveal your bingo number.</p>\
        </div>\
        <button data-passage="LockIn">Continue</button>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>\
</div>\

:: LockIn
<<set $randomQuestion = BingoGame.getRandomQuestion($questions)>>\
<<set $userAnswer = null>>\
<div class="phone">\
    <div class="screen">\
        <<if $randomQuestion>>\
            <<if $randomQuestion.type === "tf">>\
                <h1>True or False?</h1>\
            <<else>>\
                <h1>Multiple Choice</h1>\
            <</if>>\
            <div class="task-box">\
                <h4>\
                    <<print $randomQuestion.question>>\
                </h4>\
                <<if $randomQuestion.type === "tf">>\
                    <<button "True">>\
                        <<set $userAnswer = true>>\
                        <<goto "AnswerQuestion">>\
                    <</button>>\
                    <<button "False">>\
                        <<set $userAnswer = false>>\
                        <<goto "AnswerQuestion">>\
                    <</button>>\
                <<elseif $randomQuestion.type === "mc">>\
                    <div class="answer-options">\
                        <<for _i = 0; _i < $randomQuestion.options.length; _i++>>\
                            <<capture _i>>\
                                <<button $randomQuestion.options[_i]>>\
                                    <<set $userAnswer = $randomQuestion.options[_i]>>\
                                    <<goto "AnswerQuestion">>\
                                <</button>>\
                            <</capture>>\
                        <</for>>\
                    </div>\
                <</if>>\
            </div>\
        <<else>>\
            <h4>You've answered all available questions!</h4>\
            <<button "View Board">>\
                <<goto "BingoBoard">>\
            <</button>>\
        <</if>>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>\
</div>\

:: AnswerQuestion
<<set $isCorrect = ($userAnswer === $randomQuestion.answer)>>\
<<if $isCorrect>>\
    <<goto "Explanation Positive">>\
<<else>>\
    <<goto "Explanation Negative">>\
<</if>>\


:: Explanation Positive
<div class="phone">\
    <div class="screen">\
        <h1>Good Job!</h1>\
        <div>\
            <h4>\
                <<print $randomQuestion.explanation>>\
            </h4>\
            <div class="bingo-num-message">\
                <p>You've earned this bingo number!</p>\
                <h2 class="bingo-position">\
                    <<print BingoGame.getPositionLabel($selectedPosition)>>\
                </h2>\
            </div>\
            <<button "View Board">>\
                <<run BingoGame.markPosition($selectedPosition)>>\
                <<if BingoGame.checkBingo()>>\
                    <<goto "Congratulations">>\
                <<else>>\
                    <<goto "BingoBoard">>\
                <</if>>\
            <</button>>\
        </div>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>\
</div>\


:: Explanation Negative
<div class="phone">\
    <div class="screen">\
        <h1>Not Quite!</h1>\
        <div class="task-box">\
            <h4>\
                <<print $randomQuestion.explanation>>\
            </h4>\
            <div class="bingo-num-message">\
                <p>You've earned this bingo number!</p>\
                <h2 class="bingo-position">\
                    <<print BingoGame.getPositionLabel($selectedPosition)>>\
                </h2>\
            </div>\
            <<button "View Board">>\
                <<run BingoGame.markPosition($selectedPosition)>>\
                <<if BingoGame.checkBingo()>>\
                    <<goto "Congratulations">>\
                <<else>>\
                    <<goto "BingoBoard">>\
                <</if>>\
            <</button>>\
        </div>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>\
</div>\

:: Congratulations
<div class="phone">\
    <div class="screen">\
        <h1>Congratulations!</h1>\
        <div class="task-box">\
            <h2>YOU GOT BINGO!</h2>\
            <p>
                You successfully completed a winning
                combination on your bingo board!
            </p>\
            <p>
                Great job taking steps toward a
                healthier lifestyle!
            </p>\
        </div>
        <<button "View My Board">>\
            <<goto "BingoBoard">>\
        <</button>>\
        <button data-passage="Home" class="exit-btn">Exit to Home</button>\
    </div>
</div>


:: BingoBoard
<<nobr>>
<div class="phone">
    <div class="bingo-game">
        <h1>Good Luck!</h1>
        <div class="bingo-board">
            <!-- Column headers -->
            <div class="bingo-header">B</div>
            <div class="bingo-header">I</div>
            <div class="bingo-header">N</div>
            <div class="bingo-header">G</div>
            <div class="bingo-header">O</div>
            <!-- Generate all 25 bingo positions -->
            <<for _i = 0; _i < 25; _i++>>
                <<if _i === 12>>
                    <button class="bingo-cell free marked"
                        data-index="12"
                        disabled>
                        FREE
                    </button>
                <<elseif $markedPositions.includes(_i)>>
                    <<print '<button class="bingo-cell marked" data-index="' + _i + '">' + $bingoNumbers[_i] + '</button>'>>
                <<else>>
                    <<print '<button class="bingo-cell" data-index="' + _i + '">' + $bingoNumbers[_i] + '</button>'>>
                <</if>>
            <</for>>
        </div>
        <button class="bingo-reset non-bingo-btn"
            onclick="BingoGame.resetBoard()">
            Reset Board
        </button>
        <button data-passage="Home" class="exit-btn">Exit to Home</button>
    </div>
</div>
<</nobr>>