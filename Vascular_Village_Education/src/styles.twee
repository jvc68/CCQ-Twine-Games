:: StoryStylesheet [stylesheet]

body {
    margin: 0;
    background: lightgray;
}


#story {
    background: linear-gradient(180deg, #440154 0%, #3b528b 50%, #21918c 100%);
    border-radius: 32px;
    padding: 4px 8px 6px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
    color: white;
    position: relative;
    height: 660px;
    min-height: 660px;
    width: 100%;
    max-width: 390px;
    box-sizing: border-box;
    margin: 0 auto;
    font-family: 'Atkinson Hyperlegible', system-ui, -apple-system,
                 "Segoe UI", sans-serif;
}





.activity-message {
    background: rgba(255, 255, 255, 0.15);
    font-size: 14px;
}

.activity-page h2 {
    font-size: 10px;
    margin: 12px 0 7px;
    padding-bottom: 5px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
}

.activity-card {
    background: white;
    color: #172033;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
}

.activity-card h3 {
    font-size: 15px;
    margin: 0 0 4px;
}

.activity-card p {
    font-size: 13px;
    line-height: 1.35;
}

.activity-card a {
    display: inline-block;
    background: #b5f5d0;
    color: #173c2b;
    padding: 8px 11px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
}

.activity-card a:hover {
    background: #8cebb8;
}

.activity-locked {
    color: #687385;
    font-size: 13px;
    font-style: italic;
}

.completed {
    border-left: 4px solid #00c878;
}

.completed-label {
    color: #16834f;
    font-size: 13px;
    font-weight: bold;
}

.back-link {
    margin: 12px 0 4px;
    text-align: center;
    font-size: 14px;
}


/* for popup window styling */

.answer-buttons button {
    display: block;
    width: 100%;
    padding: 12px;
    margin: 10px 0;
    border: none;
    border-radius: 10px;
    background: lightblue;
    color: black;
    font-size: 16px;
    text-align: left;
    cursor: pointer;
}

.answer-buttons button:hover {
    background: skyblue;
}

/* Make the popup match the mobile game screen */

#ui-dialog {
    width: 390px;
    max-width: 100vw;
    box-sizing: border-box;
    margin: 0 auto;
}

#ui-dialog-body {
    box-sizing: border-box;
    width: 100%;
    padding: 20px;
}



/* Home screen */
.home-screen {
    text-align: center;
    color: white;
}

.home-screen h1 {
    font-size: 24px;
    margin: 4px 0 4px;
}

.home-screen p {
    font-size: 14px;
    margin: 4px 0;
}

.body-map {
    position: relative;
    width: 100%;
    max-width: 340px;
    height: 320px;
    margin: 8px auto;
}

/* Five topic circles */
.body-circle {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 8px;
    font-size: 15px;
    font-weight: bold;
    text-align: center;
    border: 3px solid white;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
}

/* Arrange the circles like a human body */
.body-circle.head {
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    background: #f5c2e7;
}

.body-circle.left {
    top: 125px;
    left: 0;
    background: #89c2d9;
}

.body-circle.center {
    top: 125px;
    left: 50%;
    transform: translateX(-50%);
    background: #f08080;
}

.body-circle.right {
    top: 125px;
    right: 0;
    background: #8bd3a8;
}

.body-circle.legs {
    top: 265px;
    left: 50%;
    transform: translateX(-50%);
    background: #f4c95d;
}

/* Make the links fill each circle */
.body-circle a {
    color: #172033;
    text-decoration: none;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    line-height: 1.3;
}

.body-circle:hover {
    filter: brightness(1.1);
    transform: scale(1.05);
}

.body-circle.head:hover,
.body-circle.center:hover,
.body-circle.legs:hover {
    transform: translateX(-50%) scale(1.05);
}

.home-hint {
    margin-top: 10px;
    font-style: italic;
}

/* Blood Vessels activity menu */
.blood-vessels-menu {
    text-align: center;
    margin: 0;
    padding: 0;
}

.blood-vessels-menu h1 {
    font-size: 21px;
    margin: 0 0 3px;
    line-height: 1.2;
}

.blood-vessels-menu .activity-message {
    font-size: 12px;
    line-height: 1.2;
    padding: 5px 7px;
    margin: 3px 0 6px;
}

/* Completed and New tabs */
.activity-tabs {
    display: flex;
    gap: 5px;
}

.activity-tabs a {
    flex: 1;
    padding: 6px 5px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    text-decoration: none;
    font-weight: bold;
    font-size: 12px;
}


.blood-vessels-menu .activity-card {
    margin: 0;
    padding: 6px 8px;
    text-align: left;
    border-radius: 9px;
}

.blood-vessels-menu .activity-card h3 {
    font-size: 13px;
    margin: 0 0 2px;
    line-height: 1.2;
}

.blood-vessels-menu .activity-card p {
    font-size: 11px;
    line-height: 1.2;
    margin: 2px 0 3px;
}

.blood-vessels-menu .activity-card a {
    padding: 5px 7px;
    font-size: 11px;
}


.activity-pagination a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 25px;
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.22);
    color: white;
    text-decoration: none;
    font-weight: bold;
}

.blood-vessels-menu .back-link {
    margin: 4px 0 0;
    font-size: 11px;
}



.activity-list {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: stretch;
    gap: 4px;
    margin: 0;
    padding: 0;
}

.activity-pagination {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin: 4px 0 0;
    padding: 0;
    margin-top: 10px;
}

